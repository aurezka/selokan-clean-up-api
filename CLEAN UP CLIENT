--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local player = Players.LocalPlayer

--------------------------------------------------
-- MODULE
--------------------------------------------------

local ClientLifecycle = {}

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local DEBUG = false

--------------------------------------------------
-- INTERNAL FLAGS
--------------------------------------------------

local initFlags = {}

--------------------------------------------------
-- STORAGE PER CONTEXT
--------------------------------------------------

local buckets = {}

local function getBucket(name)
	if not buckets[name] then
		buckets[name] = {
			connections = {},
			instances   = {},
			sounds      = {},
			mode        = "persistent", -- persistent | character | temporary
			cleaning    = false,
		}
	end
	return buckets[name]
end

--------------------------------------------------
-- MODE SETTERS
--------------------------------------------------

function ClientLifecycle.markCharacterBound(context)
	getBucket(context).mode = "character"
end

function ClientLifecycle.markTemporary(context)
	getBucket(context).mode = "temporary"
end

--------------------------------------------------
-- ENSURE SINGLE (SAFE: anti-race)
--------------------------------------------------

function ClientLifecycle.ensureSingle(context)
	local bucket = buckets[context]
	if bucket and not bucket.cleaning then
		local captured = bucket
		task.defer(function()
			if buckets[context] == captured then
				ClientLifecycle.cleanup(context, "ensure single")
			end
		end)
	end
end

--------------------------------------------------
-- TRACK HELPERS
--------------------------------------------------

local function uniqueInsert(list, item)
	for _, v in ipairs(list) do
		if v == item then
			return
		end
	end
	list[#list + 1] = item
end

--------------------------------------------------
-- TRACKERS
--------------------------------------------------

function ClientLifecycle.trackConnection(context, conn)
	if conn then
		uniqueInsert(getBucket(context).connections, conn)
	end
end

function ClientLifecycle.trackInstance(context, inst)
	if inst then
		uniqueInsert(getBucket(context).instances, inst)
	end
end

function ClientLifecycle.trackSound(context, sound)
	if sound then
		uniqueInsert(getBucket(context).sounds, sound)
	end
end

function ClientLifecycle.trackTween(context, tween)
	if tween then
		-- Tween bukan Instance, tapi kita simpan di instances list untuk dibersihkan
		uniqueInsert(getBucket(context).instances, tween)
	end
end

--------------------------------------------------
-- CLEANUP SINGLE CONTEXT
--------------------------------------------------

function ClientLifecycle.cleanup(context, reason)
	local bucket = buckets[context]
	if not bucket or bucket.cleaning then
		return
	end

	bucket.cleaning = true

	if DEBUG then
		warn("[AE CLEAN UP] Cleanup:", context, reason)
	end

	-- Connections
	for _, c in ipairs(bucket.connections) do
		pcall(function()
			if c and c.Disconnect then
				c:Disconnect()
			end
		end)
	end

	for _, i in ipairs(bucket.instances) do
		pcall(function()
		
			if typeof(i) == "Tween" then
				i:Cancel()
				return
			end

			if typeof(i) == "Instance" then
				if i.Parent then
					i:Destroy()
				end
			end
		end)
	end

	for _, s in ipairs(bucket.sounds) do
		pcall(function()
			if s and s:IsA("Sound") then
				s:Stop()
				s:Destroy()
			end
		end)
	end

	buckets[context] = nil
end

--------------------------------------------------
-- CLEANUP ALL CONTEXTS
--------------------------------------------------

function ClientLifecycle.cleanupAll(reason)
	for ctx in pairs(buckets) do
		ClientLifecycle.cleanup(ctx, reason or "cleanup all")
	end
end

--------------------------------------------------
-- INIT ONCE
--------------------------------------------------

function ClientLifecycle.initOnce(flag)
	if initFlags[flag] then
		return false
	end
	initFlags[flag] = true
	return true
end

--------------------------------------------------
-- RESET INIT FLAGS
--------------------------------------------------

function ClientLifecycle.resetInitFlags()
	for k in pairs(initFlags) do
		initFlags[k] = nil
	end
end

--------------------------------------------------
-- GLOBAL HOOKS
--------------------------------------------------

_G.AE_CLIENT_CLEANUP = function(reason)
	ClientLifecycle.cleanupAll(reason or "global cleanup")
end

_G.AE_RESET_INIT_FLAGS = function()
	ClientLifecycle.resetInitFlags()
end

--------------------------------------------------
-- CLEANUP ON RESPAWN
--------------------------------------------------

player.CharacterAdded:Connect(function()
	for ctx, bucket in pairs(buckets) do
		if bucket.mode == "temporary" or bucket.mode == "character" then
			ClientLifecycle.cleanup(ctx, "respawn")
		end
	end
end)

--------------------------------------------------
-- CLEANUP ON PLAYER LEAVE
--------------------------------------------------

player.AncestryChanged:Connect(function(_, parent)
	if not parent then
		for ctx in pairs(buckets) do
			ClientLifecycle.cleanup(ctx, "player leaving")
		end
	end
end)

--------------------------------------------------
-- RETURN
--------------------------------------------------

return ClientLifecycle
